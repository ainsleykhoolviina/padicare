PORT=3000
NODE_ENV=development

# Firebase Admin (use same credentials as frontend)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key

# Session
SESSION_SECRET=your-secret-key-here

# Vertex AI (Google Cloud project)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_MODEL=gemini-2.5-flash
# (Optional) Fine-tuned paddy disease model endpoint from Vertex AI Studio
# Format: projects/{PROJECT_NUMBER}/locations/{LOCATION}/endpoints/{ENDPOINT_ID}
# If not set, disease detection will use the base model above
GOOGLE_CLOUD_TUNED_MODEL=

GOOGLE_APPLICATION_CREDENTIALS=./your-service-account-key.json

# Google Maps API Proxy
GOOGLE_MAPS_SERVER_KEY=your-google-maps-api-key

# OpenCage Geocoding
OPENCAGE_API_KEY=your-opencage-api-key
