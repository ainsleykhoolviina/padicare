# ─────────────────────────────────────────────────────────────
# Deploy Environment Variables
# Copy this file to .env.deploy and fill in your values:
#   cp .env.deploy.example .env.deploy
# Then run: source .env.deploy && ./deploy.sh
# ─────────────────────────────────────────────────────────────

# Google Cloud
export GCP_PROJECT_ID=your-gcp-project-id
export GCP_REGION=asia-southeast1
export GCP_SERVICE_NAME=padi-smart-aid

# Frontend (Vite build args — baked into JS bundle)
export VITE_FIREBASE_API_KEY=your-firebase-api-key
export VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
export VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
export VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
export VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
export VITE_FIREBASE_APP_ID=your-app-id
export VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
export VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Backend (Cloud Run env vars)
export SESSION_SECRET=generate-a-strong-random-secret
export FIREBASE_PROJECT_ID=your-firebase-project-id
export FIREBASE_API_KEY=your-firebase-api-key
export GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
export GOOGLE_CLOUD_LOCATION=us-central1
export GOOGLE_CLOUD_MODEL=gemini-2.5-flash
export GOOGLE_MAPS_SERVER_KEY=your-google-maps-server-key
export OPENCAGE_API_KEY=your-opencage-api-key
